# Copy to .env.local for local use, or set these in your hosting dashboard.
# Everything is optional; defaults are in lib/site.js.

NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=you@your-domain.com

# Google AdSense (after approval)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_JOB=

# Payment link for featured listings (Stripe Payment Link, Lemon Squeezy...)
NEXT_PUBLIC_FEATURED_LISTING_URL=

# Form endpoint that accepts an "email" field (Buttondown, Formspree...)
NEXT_PUBLIC_NEWSLETTER_ACTION=
